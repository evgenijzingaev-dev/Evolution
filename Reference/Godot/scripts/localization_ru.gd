static var _keys: Array = []
static var _cache: Dictionary = {}

static func text(value: String) -> String:
	if _cache.has(value):
		return _cache[value]
	if _keys.is_empty():
		_keys = WORDS.keys()
		_keys.sort_custom(func(a: String, b: String) -> bool: return a.length() > b.length())
	var result := value
	for key in _keys:
		result = result.replace(str(key), str(WORDS[key]))
		result = result.replace(str(key).to_upper(), str(WORDS[key]).to_upper())
		result = result.replace(str(key).capitalize(), str(WORDS[key]))
	if _cache.size() > 4096:
		_cache.clear()
	_cache[value] = result
	return result

static func apply_tree(node: Node) -> void:
	if node is Control and not node.tooltip_text.is_empty(): node.tooltip_text = text(node.tooltip_text)
	if node is OptionButton:
		for index in range(node.item_count):
			node.set_item_text(index, text(node.get_item_text(index)))
	elif node is Label or node is Button or node is RichTextLabel:
		node.text = text(node.text)
	if node is Window:
		node.title = text(node.title)
	if node is AcceptDialog:
		node.dialog_text = text(node.dialog_text)
	if node is LineEdit:
		node.placeholder_text = text(node.placeholder_text)
	for child in node.get_children():
		apply_tree(child)

